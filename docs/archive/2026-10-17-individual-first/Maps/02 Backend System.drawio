<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Branch connected diagrams" version="24.7.17" type="device"><diagram id="backend" name="Backend process"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3080" pageHeight="2560" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="BRANCH / Backend process" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=36;fontColor=#243A2F;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="2200" height="60" as="geometry" /></mxCell><object id="B01" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;START&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request&lt;/b&gt;" tooltip="The backend boundary accepts operations from any authorized client. Capture happens on the device; this boundary receives saved content or upload chunks. API framework and hosting provider are not selected."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="160" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B02" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B02&lt;/span&gt;&lt;br&gt;&lt;b&gt;Check access&lt;/b&gt;" tooltip="Enforce access on writes, reads, model context, derived snippets and exports. A UI filter alone is not an access control. Scope must be rechecked when a queued job actually executes."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B03" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B03&lt;/span&gt;&lt;br&gt;&lt;b&gt;Ingest source&lt;/b&gt;" tooltip="Use resumable upload where required. Validation errors return a specific status; save only verified chunks or an explicitly incomplete source. Idempotency prevents retries creating duplicate sources."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B04" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B04&lt;/span&gt;&lt;br&gt;&lt;b&gt;Store original&lt;/b&gt;" tooltip="Preserve original source material and its version separately from model-generated claims. Audio timestamps exist only when grounded in audio. Storage may be local, hosted or mixed; this map does not choose that deployment."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1600" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B05" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B05&lt;/span&gt;&lt;br&gt;&lt;b&gt;Queue job&lt;/b&gt;" tooltip="Jobs are retryable with bounded attempts and idempotent outputs. Cancellation, changed permissions or deletion prevents later work from using revoked material. Status updates can be polled or streamed; transport is undecided."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B06" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Report failure&lt;/b&gt;" tooltip="A failed parser, transcription job or model operation must not silently create an empty successful map. Report actionable error state to the client. Retry reuses source and job identifiers."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2560" y="220" width="260" height="100" as="geometry" /></mxCell></object><object id="B07" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B07&lt;/span&gt;&lt;br&gt;&lt;b&gt;Permissions&lt;/b&gt;" tooltip="Permissions and source lineage constrain derived content. A node with mixed-scope evidence cannot become more visible than its supporting material without an explicit authorized redaction step."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="540" width="260" height="100" as="geometry" /></mxCell></object><object id="B08" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B08&lt;/span&gt;&lt;br&gt;&lt;b&gt;Check AI scope&lt;/b&gt;" tooltip="Gate each optional transcription, extraction and semantic retrieval operation. Saving a source is not automatic permission to send it to a cloud model. Provider and training terms remain a product implementation requirement."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="560" width="260" height="100" as="geometry" /></mxCell></object><object id="B09" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B09&lt;/span&gt;&lt;br&gt;&lt;b&gt;Prepare source&lt;/b&gt;" tooltip="Non-AI parsing can extract text from supported formats. With AI off, an audio-only source remains an accessible recording with metadata; there is no invented automatic transcript."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="900" width="260" height="100" as="geometry" /></mxCell></object><object id="B10" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Transcribe&lt;/b&gt;" tooltip="Optional AI operation for allowed audio. Its output is a source-derived transcript with locations, not an authoritative decision record. The original recording remains separately referenced."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2560" y="560" width="260" height="100" as="geometry" /></mxCell></object><object id="B11" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Retrieve&lt;/b&gt;" tooltip="Apply permission filters before ranking, before assembling model context and before returning output. Resolve current revisions and visibility; do not leak inaccessible labels, counts or snippets."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="B12" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Search index&lt;/b&gt;" tooltip="An index is a derived retrieval structure, not the authority for permissions or current graph state. Update it on accepted edits and source changes; invalidate on deletion or revoked scope."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1600" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="B13" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Propose ideas&lt;/b&gt;" tooltip="Optional model step. Proposed types: Idea, Question, Constraint, Finding and Decision. Inferred connections remain suggestions. New sources produce change sets against existing records rather than replacing the entire graph."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1600" y="900" width="260" height="100" as="geometry" /></mxCell></object><object id="B14" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Check evidence&lt;/b&gt;" tooltip="Check that cited segments exist and assertions are supported. A source mentioning a possible decision must not become a confirmed decision automatically. Low support remains visible for human review; automated checks do not establish truth."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="900" width="260" height="100" as="geometry" /></mxCell></object><object id="B15" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Draft ready&lt;/b&gt;" tooltip="Separate model proposals from accepted graph content. Draft IDs allow partial acceptance, editing or dismissal. Model outputs cannot directly write the canonical graph."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="1240" width="260" height="100" as="geometry" /></mxCell></object><object id="B16" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Edit / accept&lt;/b&gt;" tooltip="A manual edit and an accepted AI suggestion use the same write contract. Require action permission, actor identity, current expected revision and explicit selected changes; rejection is a state change, not source deletion."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="1240" width="260" height="100" as="geometry" /></mxCell></object><object id="B17a" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B17a&lt;/span&gt;&lt;br&gt;&lt;b&gt;Apply change&lt;/b&gt;" tooltip="Recheck scope at commit, validate node and edge references, enforce version checks and write graph changes with their revision record. Concurrent edits are not silently overwritten; conflict returns to review."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="B17" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B17&lt;/span&gt;&lt;br&gt;&lt;b&gt;Saved ideas&lt;/b&gt;" tooltip="Canonical accepted state. One idea may belong to several projects. A derivative receives a new identity and a relationship to the original. Graph persistence need not imply a specific graph-database product."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="B18" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B18&lt;/span&gt;&lt;br&gt;&lt;b&gt;Revision history&lt;/b&gt;" tooltip="Store the accepted revision and provenance together with the corresponding graph change. Preserve disputed and superseded states rather than presenting them as current consensus."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="1920" width="260" height="100" as="geometry" /></mxCell></object><object id="B19" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Map ready&lt;/b&gt;" tooltip="Build a bounded view of authorized current records. Position and filter data can be view state; changing the view must not mutate the stored graph. No inaccessible source labels or hidden edges should be revealed."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2560" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="B20" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Matches ready&lt;/b&gt;" tooltip="Text matches can work without AI. Semantic suggestions are optional and use the same processing gate. User selection creates an explicit link or derivative through the command path, not through this read service."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="1920" width="260" height="100" as="geometry" /></mxCell></object><object id="B21" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Export ready&lt;/b&gt;" tooltip="Export only chosen authorized context. Exclude unreviewed inference unless clearly included as such; identify disputed or superseded content. Portable exports leave the access-control boundary and cannot be remotely recalled."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2560" y="1920" width="260" height="100" as="geometry" /></mxCell></object><object id="B22" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B22&lt;/span&gt;&lt;br&gt;&lt;b&gt;Agent access&lt;/b&gt;" tooltip="Future optional access to selected project context. Every request is checked under the current access policy. This connector does not grant model tools permission to modify the map or act on behalf of the user."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="2560" y="2260" width="260" height="100" as="geometry" /></mxCell></object><object id="B23" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B23&lt;/span&gt;&lt;br&gt;&lt;b&gt;Project roles&lt;/b&gt;" tooltip="Future sharing services create scoped role grants and enforce source-derived visibility. Corporate rollout may additionally need administration and retention management; these do not gate individual value."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="160" y="2260" width="260" height="100" as="geometry" /></mxCell></object><object id="B24" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B24&lt;/span&gt;&lt;br&gt;&lt;b&gt;Shared changes&lt;/b&gt;" tooltip="Shared commands pass the same access, revision and evidence rules as private commands. Comments are not automatically decisions. Shared proposals feed the pending-change and review contract."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="2260" width="260" height="100" as="geometry" /></mxCell></object><object id="B25" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;B25&lt;/span&gt;&lt;br&gt;&lt;b&gt;Delete / retain&lt;/b&gt;" tooltip="Remove or invalidate source-derived data according to the selected retention policy, including transcripts, semantic indexes, pending proposals and cached outputs. Preserve only policy-allowed tombstones/history. A deletion should not be undone by an in-flight retry."><mxCell style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCBC1;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="1920" width="260" height="100" as="geometry" /></mxCell></object><object id="E01" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Source ready&lt;/b&gt;" tooltip="Original material is available without semantic generation. Supported text remains searchable. Audio without permitted transcription remains an audio source with metadata."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="2560" y="900" width="260" height="100" as="geometry" /></mxCell></object><object id="E02" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access denied&lt;/b&gt;" tooltip="The request ends without reading, writing or exposing unauthorized content."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="160" y="540" width="260" height="100" as="geometry" /></mxCell></object><object id="E03" label="&lt;span style=&quot;font-size:15px;color:#69766E&quot;&gt;OUTCOME&lt;/span&gt;&lt;br&gt;&lt;b&gt;Conflict returned&lt;/b&gt;" tooltip="A stale expected revision returns a conflict without overwriting accepted records. The user reviews the conflict before submitting a new authorized command."><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#426E57;strokeWidth=2;fontColor=#243A2F;fontFamily=Segoe UI;fontSize=27;spacing=19;align=left;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="160" y="1580" width="260" height="100" as="geometry" /></mxCell></object><object id="edge0" label="Read policy" tooltip="reads policy"><mxCell style="edgeStyle=segmentEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=12;html=1;endArrow=open;strokeWidth=3;strokeColor=#65796C;fontFamily=Segoe UI;fontSize=24;fontColor=#65796C;labelBackgroundColor=#FFFFFF;exitX=0.6538461538461539;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="B02" target="B07"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="500" /><mxPoint x="770" y="500" /></Array><mxPoint x="92.75" y="5.0" as="offset" /></mxGeometry></mxCell></object><object id="edge1" label="Constrain" tooltip="constrains AI use"><mxCell style="edgeStyle=segmentEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=12;html=1;endArrow=open;strokeWidth=3;strokeColor=#65796C;fontFamily=Segoe UI;fontSize=24;fontColor=#65796C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="B07" target="B08"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2040" y="590" /><mxPoint x="2040" y="610" /></Array><mxPoint x="-30.0" y="29.0" as="offset" /></mxGeometry></mxCell></object><object id="edge2" label="" tooltip="indexes source text"><mxCell style="edgeStyle=segmentEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=12;html=1;endArrow=open;strokeWidth=3;strokeColor=#65796C;fontFamily=Segoe UI;fontSize=24;fontColor=#65796C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="B09" target="B12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2210" y="1040" /><mxPoint x="1730" y="1040" /></Array></mxGeometry></mxCell></object><object id="edge3" label="Read index" tooltip="searches index"><mxCell style="edgeStyle=segmentEdgeStyle;rounded=0;